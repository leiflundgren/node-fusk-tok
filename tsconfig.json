{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es6",
    "lib": [ "es2017", "DOM" ],
    "types": [ "node" ],
    "sourceMap": true,
    "strict": false,
    "skipLibCheck": true,

    "rootDir": "src",
    "outDir": "dist",
    "paths": {
      "@/*": [ "./src/*" ]
    }

  },
  "exclude": [
    "node_modules",
    ".vs"
  ]
}
